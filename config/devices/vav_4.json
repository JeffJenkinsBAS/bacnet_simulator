{
  "group_id": "ACI-SIM-VAV-4",
  "instance_offset": 14000,
  "description": "Simulated virtual VAV zone 4 -- no physical controller exists yet. Same point set as VAV-1/VAV-2 plus a simulated Zone Temp, since there's no real ZS thermostat for this zone.",
  "points": [
    {
      "alias": "discharge_temp",
      "object_type": "analog-input",
      "object_instance": 1,
      "object_name": "VAV-4 Discharge Temp",
      "description": "Simulated discharge air temperature",
      "units": "degrees-fahrenheit",
      "signal_direction": "sim_to_webctrl",
      "writable": false,
      "initial_value": 55.0,
      "minimum": 40.0,
      "maximum": 120.0,
      "update_interval_seconds": 1,
      "cov_increment": 0.5,
      "normal_range": {
        "low": 55.0,
        "high": 95.0
      }
    },
    {
      "alias": "damper_position_command",
      "object_type": "analog-output",
      "object_instance": 20,
      "object_name": "VAV-4 Damper Position Command",
      "description": "Calculated primary-air damper position, sent to the simulator",
      "units": "percent",
      "signal_direction": "webctrl_to_sim",
      "writable": true,
      "commandable": true,
      "initial_value": 0.0,
      "minimum": 0.0,
      "maximum": 100.0,
      "update_interval_seconds": 1,
      "relinquish_default": 0.0
    },
    {
      "alias": "hw_valve_command",
      "object_type": "analog-output",
      "object_instance": 21,
      "object_name": "VAV-4 HW Valve",
      "description": "Reheat valve position command",
      "units": "percent",
      "signal_direction": "webctrl_to_sim",
      "writable": true,
      "commandable": true,
      "initial_value": 0.0,
      "minimum": 0.0,
      "maximum": 100.0,
      "update_interval_seconds": 1,
      "relinquish_default": 0.0
    },
    {
      "alias": "airflow_setpoint",
      "object_type": "analog-output",
      "object_instance": 22,
      "object_name": "VAV-4 Airflow Setpoint",
      "description": "Calculated target airflow -- context for the simulator, not a hard override of the simulated Airflow value",
      "units": "cubic-feet-per-minute",
      "signal_direction": "webctrl_to_sim",
      "writable": true,
      "commandable": true,
      "initial_value": 0.0,
      "minimum": 0.0,
      "maximum": 2000.0,
      "update_interval_seconds": 1,
      "relinquish_default": 0.0
    },
    {
      "alias": "airflow",
      "object_type": "analog-value",
      "object_instance": 80,
      "object_name": "VAV-4 Airflow",
      "description": "Simulated actual measured airflow",
      "units": "cubic-feet-per-minute",
      "signal_direction": "sim_to_webctrl",
      "writable": false,
      "commandable": false,
      "initial_value": 0.0,
      "minimum": 0.0,
      "maximum": 2000.0,
      "update_interval_seconds": 1,
      "cov_increment": 5.0
    },
    {
      "alias": "zone_temp",
      "object_type": "analog-input",
      "object_instance": 2,
      "object_name": "VAV-4 Zone Temp",
      "description": "Simulated zone temperature (virtual zone, no physical ZS thermostat)",
      "units": "degrees-fahrenheit",
      "signal_direction": "sim_to_webctrl",
      "writable": false,
      "initial_value": 72.0,
      "minimum": 50.0,
      "maximum": 100.0,
      "update_interval_seconds": 1,
      "cov_increment": 0.2,
      "normal_range": {
        "low": 68.0,
        "high": 76.0
      }
    }
  ]
}
