{
  "group_id": "ACI-SIM-CHW-PLANT",
  "instance_offset": 1000,
  "description": "Chiller Manager's plant-level status/common-header points, plus Emerg/Refrig Shutdown hard interlocks.",
  "points": [
    {
      "alias": "ch1_power_loss",
      "object_type": "binary-input",
      "object_instance": 40,
      "object_name": "CHW-PLANT CH 1 Power Loss",
      "description": "Simulated chiller 1 power loss alarm",
      "units": "no-units",
      "signal_direction": "alarm_fault",
      "writable": false,
      "initial_value": 0,
      "update_interval_seconds": 1
    },
    {
      "alias": "ch2_power_loss",
      "object_type": "binary-input",
      "object_instance": 41,
      "object_name": "CHW-PLANT CH 2 Power Loss",
      "description": "Simulated chiller 2 power loss alarm",
      "units": "no-units",
      "signal_direction": "alarm_fault",
      "writable": false,
      "initial_value": 0,
      "update_interval_seconds": 1
    },
    {
      "alias": "ch3_power_loss",
      "object_type": "binary-input",
      "object_instance": 42,
      "object_name": "CHW-PLANT CH 3 Power Loss",
      "description": "Simulated chiller 3 power loss alarm",
      "units": "no-units",
      "signal_direction": "alarm_fault",
      "writable": false,
      "initial_value": 0,
      "update_interval_seconds": 1
    },
    {
      "alias": "chiller1_ok",
      "object_type": "binary-input",
